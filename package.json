{
  "name": "@klnap/payload-redirect",
  "version": "0.4.12",
  "description": "Redirect management for Payload CMS.",
  "homepage": "https://github.com/klnap/payload-redirect#readme",
  "bugs": {
    "url": "https://github.com/klnap/payload-redirect/issues"
  },
  "keywords": [
    "payload",
    "payloadcms",
    "payload-plugin",
    "cms",
    "redirect",
    "redirects",
    "redirect-management"
  ],
  "license": "MIT",
  "author": "klnap",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/klnap/payload-redirect.git"
  },
  "type": "module",
  "sideEffects": false,
  "packageManager": "bun@1.4.5",
  "exports": {
    ".": {
      "types": "./dist/exports/index.d.ts",
      "import": "./dist/exports/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs/FAILURE_SEMANTICS.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:consumer": "tsc -p tsconfig.type-fixture.json && tsc -p tsconfig.type-fixture.no-generated.json && tsc -p tsconfig.type-fixture.readme.json",
    "test": "bun test src tests/unit",
    "test:int": "bun scripts/with-ephemeral-postgres.mjs scripts/ephemeral-postgres.config.mjs -- bun test tests/integration tests/security --max-concurrency 1 --timeout=15000",
    "check:boundaries": "depcruise --config dependency-cruiser.config.mjs --output-type err-long src",
    "lint": "biome lint .",
    "format": "biome format .",
    "format:write": "biome format --write .",
    "verify:package": "publint --strict && attw --profile esm-only --pack .",
    "check": "bun run format && bun run lint && bun run check:boundaries && bun run typecheck && bun run test && bun run build && bun run typecheck:consumer && bun run verify:package && bun run check:exports",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:version-check": "bun run changeset:version && bun run check",
    "check:exports": "bun scripts/check-exports.mjs",
    "build": "bun -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json"
  },
  "peerDependencies": {
    "@payloadcms/db-postgres": ">=3.94.1 <4",
    "payload": ">=3.94.1 <4"
  },
  "peerDependenciesMeta": {
    "@payloadcms/db-postgres": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@biomejs/biome": "2.6.8",
    "@changesets/cli": "3.0.3",
    "@swc/core": "1.16.22",
    "@payloadcms/db-postgres": "3.94.1",
    "@payloadcms/graphql": "3.94.1",
    "@payloadcms/richtext-lexical": "3.94.1",
    "@types/bun": "1.4.5",
    "@types/pg": "^8.23.1",
    "dependency-cruiser": "^18.8.0",
    "graphql": "16.15.0",
    "next": "16.4.6",
    "npm": "12.2.3",
    "publint": "0.3.25",
    "payload": "3.94.1",
    "pg": "^8.23.1",
    "tsc-alias": "^1.9.10",
    "typescript": "7.0.2",
    "@types/node": "^26.0.0"
  },
  "overrides": {
    "happy-dom": "21.0.4"
  },
  "engines": {
    "node": "^22.23.5 || ^24.22.3 || >=26.13.1"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "types": "./dist/exports/index.d.ts"
}
